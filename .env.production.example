# Copy this file to .env.production on the server. Never commit the copy.
# MYSQL_PASSWORD must be URL-safe because it is embedded in DATABASE_URL.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_PASSWORD=replace-with-a-long-url-safe-password
AUTH_CODE=replace-with-a-long-random-auth-code

# Optional: set an npm registry reachable from the build server.
NPM_REGISTRY=https://registry.npmjs.org

SERVER_ORIGIN_URL=https://rss.tuotuzju.com
PLATFORM_URL=https://weread.111965.xyz
FEED_MODE=fulltext
MAX_REQUEST_PER_MINUTE=60
CRON_EXPRESSION=35 5,17 * * *
UPDATE_DELAY_TIME=60
ENABLE_CLEAN_HTML=false
